{
  // Development only: SQL statements at Information, plus a daily rolling file
  // in Brainova.PL/logs/ (gitignored) that keeps the last 7 days.
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": {
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/brainova-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  }
}
