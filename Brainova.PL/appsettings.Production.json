{
  // Production only (Azure App Service, Windows).
  // Windows App Service does not capture console output, so logs also go to a file in
  // D:\home\LogFiles\Application, the folder Azure's Log stream and Kudu read from.
  //   shared + flushToDiskInterval: Azure reads the file while the app is still writing it.
  //   rollingInterval: a new file per day; also means the folder is only touched on the
  //   first log line, so a host without D:\home (e.g. the mirror) just skips this sink.
  //   7 files, max 10 MB each: stays far inside the Free plan's 1 GB of storage.
  "Serilog": {
    "WriteTo": {
      "AzureFile": {
        "Name": "File",
        "Args": {
          "path": "D:\\home\\LogFiles\\Application\\brainova-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  }
}
