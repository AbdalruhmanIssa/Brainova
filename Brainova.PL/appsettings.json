{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secrets are intentionally empty here. This file is tracked in git.
  // Local development: dotnet user-secrets (see README - Configuration).
  // Production: environment variables using the __ separator,
  //   ConnectionStrings__Default, jwtOptions__SecretKey, Smtp__AppPassword.
  "ConnectionStrings": {
    "Default": ""
  },
  "jwtOptions": {
    "SecretKey": "",
    "Issuer": "Brainova",
    "Audience": "BrainovaUsers",
    "DurationInMinutes": 60
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "AppPassword": "",
    "From": ""
  }
}
