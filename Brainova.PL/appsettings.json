{
  // Logging is handled by Serilog (see Program.cs). Sinks are named objects rather than
  // an array so appsettings.{Environment}.json can add one without replacing the others.
  // Override any level in production with an env var, e.g. Serilog__MinimumLevel__Default=Debug
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    },
    "Properties": {
      "Application": "Brainova.API"
    }
  },
  "AllowedHosts": "*",

  // Secrets are intentionally empty here. This file is tracked in git.
  // Local development: dotnet user-secrets (see README - Configuration).
  // Production: environment variables using the __ separator,
  //   ConnectionStrings__Default, jwtOptions__SecretKey, Smtp__AppPassword.
  "ConnectionStrings": {
    "Default": ""
  },
  "jwtOptions": {
    "SecretKey": "",
    "Issuer": "Brainova",
    "Audience": "BrainovaUsers",
    "DurationInMinutes": 60
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "AppPassword": "",
    "From": ""
  }
}
